---
const productos = [
    {
        nombre: "Hielo en Cubos",
        descripcion: "Cubos sólidos de 2×2 cm ideales para bebidas, coctelería y gastronomía. Máxima claridad y durabilidad.",
        usos: ["Bares y restaurantes", "Hoteles", "Catering"],
        icon: "⬛",
    },
    {
        nombre: "Hielo Escama",
        descripcion: "Escamas finas y maleables, perfectas para conservación de alimentos, pescados y presentaciones.",
        usos: ["Pescaderías", "Supermercados", "Laboratorios"],
        icon: "❄️",
    },
    {
        nombre: "Hielo en Bolsa",
        descripcion: "Presentación envasada al vacío en bolsas de 1, 3 y 5 kg. Listo para uso inmediato y distribución masiva.",
        usos: ["Comercios", "Eventos", "Distribuidores"],
        icon: "📦",
    },
    {
        nombre: "Hielo Seco",
        descripcion: "CO₂ sólido para transporte de productos sensibles a la temperatura y efectos especiales.",
        usos: ["Farmacéutica", "Logística", "Eventos"],
        icon: "🌫️",
    },
];
---

<section id="productos" class="py-28 px-8 md:px-20 bg-[#F4F7F9]">
    <div class="max-w-6xl mx-auto">
        <div class="mb-16">
        <p class="text-xs tracking-[0.4em] uppercase text-[#3B9ED4] mb-4 font-medium">Lo que producimos</p>
        <h2 class="font-['Bebas_Neue'] text-6xl md:text-7xl text-[#0D1B2A] leading-none">PRODUCTOS</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-[#D0DDE6]">
        {productos.map((p, i) => (
            <div class="bg-[#F4F7F9] p-10 group hover:bg-[#0D1B2A] transition-colors duration-500 cursor-default">
            <span class="text-3xl mb-6 block">{p.icon}</span>
            <h3 class="font-['Bebas_Neue'] text-3xl text-[#0D1B2A] group-hover:text-white mb-3 tracking-wide transition-colors duration-500">{p.nombre}</h3>
            <p class="text-sm font-light text-[#4A6070] group-hover:text-[#A8C0CC] leading-relaxed mb-6 transition-colors duration-500">{p.descripcion}</p>
            <div class="flex flex-wrap gap-2">
                {p.usos.map(u => (
                <span class="text-xs tracking-wider uppercase border border-[#D0DDE6] group-hover:border-[#3B9ED4] text-[#4A6070] group-hover:text-[#3B9ED4] px-3 py-1 transition-colors duration-500">{u}</span>
                ))}
            </div>
            </div>
        ))}
        </div>
    </div>
</section>