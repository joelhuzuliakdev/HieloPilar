---
---

<!-- ── NAVBAR ── -->
<header class="fixed top-0 left-0 right-0 z-50 px-6 py-4 flex justify-between items-center bg-[#F4F7F9]/80 backdrop-blur-md border-b border-[#D0DDE6]">
    <span class="font-['Bebas_Neue'] text-2xl tracking-widest text-[#0D1B2A]">
        HIELO<span class="text-[#3B9ED4]">PILAR</span>
    </span>

    <!-- Links desktop -->
    <nav class="hidden md:flex gap-10 text-sm font-light tracking-wider text-[#4A6070] uppercase">
        <a href="#productos" class="nav-link hover:text-[#0D1B2A] transition-colors">Productos</a>
        <a href="#proceso"   class="nav-link hover:text-[#0D1B2A] transition-colors">Proceso</a>
        <a href="#contacto"  class="nav-link hover:text-[#0D1B2A] transition-colors">Contacto</a>
    </nav>

    <div class="flex items-center gap-4">
        <a href="#contacto" class="nav-link hidden md:inline-block text-sm tracking-widest uppercase border border-[#3B9ED4] text-[#3B9ED4] px-5 py-2 hover:bg-[#3B9ED4] hover:text-white transition-all duration-300">
        Cotizar
        </a>
        <!-- Hamburger -->
        <button id="menu-btn" aria-label="Abrir menú" class="md:hidden flex flex-col gap-[5px] justify-center items-center w-9 h-9">
        <span class="burger-line block w-6 h-[1.5px] bg-[#0D1B2A] transition-all duration-300 origin-center"></span>
        <span class="burger-line block w-6 h-[1.5px] bg-[#0D1B2A] transition-all duration-300"></span>
        <span class="burger-line block w-6 h-[1.5px] bg-[#0D1B2A] transition-all duration-300 origin-center"></span>
        </button>
    </div>
</header>

<!-- ── MENÚ MOBILE ── -->
<div
    id="mobile-menu"
    class="fixed inset-0 z-40 bg-[#F4F7F9] flex flex-col justify-center items-center gap-10
            translate-x-full transition-transform duration-500 ease-in-out md:hidden"
    >
    <span class="font-['Bebas_Neue'] text-3xl tracking-widest text-[#0D1B2A] absolute top-6 left-6">
        HIELO<span class="text-[#3B9ED4]">PILAR</span>
    </span>
    <a href="#productos" class="mobile-nav-link font-['Bebas_Neue'] text-6xl text-[#0D1B2A] hover:text-[#3B9ED4] transition-colors tracking-wider">Productos</a>
    <a href="#proceso"   class="mobile-nav-link font-['Bebas_Neue'] text-6xl text-[#0D1B2A] hover:text-[#3B9ED4] transition-colors tracking-wider">Proceso</a>
    <a href="#contacto"  class="mobile-nav-link font-['Bebas_Neue'] text-6xl text-[#0D1B2A] hover:text-[#3B9ED4] transition-colors tracking-wider">Contacto</a>
    <a href="#contacto"  class="mobile-nav-link mt-4 text-sm tracking-widest uppercase border border-[#3B9ED4] text-[#3B9ED4] px-8 py-3 hover:bg-[#3B9ED4] hover:text-white transition-all duration-300">
        Cotizar
    </a>
</div>

<!-- ── HERO ── -->
<section class="min-h-screen flex flex-col justify-center pt-28 pb-16 px-8 md:px-20 relative overflow-hidden">
    <!-- Grid de fondo -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: repeating-linear-gradient(0deg,#3B9ED4 0px,#3B9ED4 1px,transparent 1px,transparent 60px),repeating-linear-gradient(90deg,#3B9ED4 0px,#3B9ED4 1px,transparent 1px,transparent 60px);"></div>

    <!-- Círculos decorativos -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full border border-[#C8DDE9] opacity-40 translate-x-1/3"></div>
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[400px] h-[400px] rounded-full border border-[#3B9ED4] opacity-20 translate-x-1/3"></div>

    <div class="max-w-5xl relative z-10">
        <p class="text-xs tracking-[0.4em] uppercase text-[#3B9ED4] mb-6 font-medium">Fábrica Industrial · Desde 1998</p>
        <h1 class="font-['Bebas_Neue'] text-[clamp(4rem,12vw,10rem)] leading-none tracking-tight text-[#0D1B2A] mb-8">
        PUREZA<br />
        <span class="text-[#3B9ED4]">EN CADA</span><br />
        CUBO
        </h1>
        <p class="text-lg md:text-xl font-light text-[#4A6070] max-w-xl leading-relaxed mb-12">
        Producción de hielo industrial de alta calidad para gastronomía, industria y eventos. Entrega en tiempo y forma, todos los días.
        </p>
        <div class="flex flex-wrap gap-4">
        <a href="#productos" class="nav-link bg-[#0D1B2A] text-white text-sm tracking-widest uppercase px-8 py-4 hover:bg-[#1a2e40] transition-colors duration-300">
            Ver productos
        </a>
        <a href="#contacto" class="nav-link text-sm tracking-widest uppercase px-8 py-4 border border-[#D0DDE6] text-[#4A6070] hover:border-[#0D1B2A] hover:text-[#0D1B2A] transition-all duration-300">
            Solicitar cotización
        </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="mt-24 pt-10 border-t border-[#D0DDE6] grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl relative z-10">
        {[
        { num: "25+", label: "Años de experiencia" },
        { num: "50T", label: "Producción diaria" },
        { num: "300+", label: "Clientes activos" },
        { num: "24hs", label: "Servicio continuo" },
        ].map(s => (
        <div>
            <p class="font-['Bebas_Neue'] text-5xl text-[#3B9ED4] leading-none">{s.num}</p>
            <p class="text-xs uppercase tracking-widest text-[#4A6070] mt-2 font-light">{s.label}</p>
        </div>
        ))}
    </div>
</section>

<!-- ── SCRIPT ── -->
<script>
    // ── Scroll suave ──────────────────────────────────────────────
    document.querySelectorAll('a.nav-link, a.mobile-nav-link').forEach(link => {
        link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href?.startsWith('#')) return;
        const target = document.querySelector(href);
        if (!target) return;
        e.preventDefault();
        // Cerrar menú mobile si está abierto
        closeMobileMenu();
        const navH = document.querySelector('header')?.offsetHeight ?? 72;
        const top = target.getBoundingClientRect().top + window.scrollY - navH;
        window.scrollTo({ top, behavior: 'smooth' });
        });
    });

    // ── Menú hamburguesa ──────────────────────────────────────────
    const btn      = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const lines    = document.querySelectorAll('.burger-line');
    let isOpen     = false;

    function openMobileMenu() {
        isOpen = true;
        mobileMenu?.classList.remove('translate-x-full');
        mobileMenu?.classList.add('translate-x-0');
        // Animar a X
        lines[0]?.classList.add('rotate-45', 'translate-y-[6.5px]');
        lines[1]?.classList.add('opacity-0', 'scale-x-0');
        lines[2]?.classList.add('-rotate-45', '-translate-y-[6.5px]');
        document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
        if (!isOpen) return;
        isOpen = false;
        mobileMenu?.classList.add('translate-x-full');
        mobileMenu?.classList.remove('translate-x-0');
        // Volver a hamburguesa
        lines[0]?.classList.remove('rotate-45', 'translate-y-[6.5px]');
        lines[1]?.classList.remove('opacity-0', 'scale-x-0');
        lines[2]?.classList.remove('-rotate-45', '-translate-y-[6.5px]');
        document.body.style.overflow = '';
    }

    btn?.addEventListener('click', () => isOpen ? closeMobileMenu() : openMobileMenu());
</script>